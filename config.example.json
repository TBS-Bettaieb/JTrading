{
  "ProjectName": "RSI Divergence Trading System",
  "Version": "2.0",
  "Description": "Configuration pour le déploiement automatique vers MetaTrader 5",

  "SourcePaths": {
    "EA": "EA",
    "Indicators": "Indicators",
    "Shared": "Shared"
  },

  "FileExtensions": {
    "EA": ["*.mq5"],
    "Indicators": ["*.mq5"],
    "Shared": ["*.mqh"]
  },

  "TargetSubdirectories": {
    "EA": "Experts",
    "Indicators": "Indicators",
    "Shared": "Shared"
  },

  "MT5SearchPaths": [
    "C:\\Program Files\\*MetaTrader*",
    "C:\\Program Files (x86)\\*MetaTrader*",
    "%APPDATA%\\MetaQuotes\\Terminal\\*"
  ],

  "RegistryPaths": [
    "HKLM:\\SOFTWARE\\MetaQuotes\\MetaTrader 5",
    "HKLM:\\SOFTWARE\\WOW6432Node\\MetaQuotes\\MetaTrader 5"
  ],

  "DeploymentOptions": {
    "CreateBackup": true,
    "BackupSuffix": ".backup.{timestamp}",
    "OverwriteExisting": true,
    "CreateDirectories": true
  },

  "Logging": {
    "Enabled": true,
    "Level": "Info",
    "File": "Deploy-MT5-{timestamp}.log",
    "Console": true,
    "Colors": {
      "Info": "White",
      "Warning": "Yellow",
      "Error": "Red",
      "Success": "Green",
      "Debug": "Gray"
    }
  },

  "UI": {
    "ShowProgress": true,
    "InteractiveMode": true,
    "ConfirmActions": true,
    "ShowDetailedReport": true
  },

  "Advanced": {
    "RecursiveSearch": true,
    "ValidateFiles": true,
    "CheckPermissions": true,
    "ElevateIfNeeded": false
  }
}
