; Configuration optimisée pour M5/M15 - ADX Score Master
; Basée sur l'analyse des timeframes courts et la volatilité élevée

; === Trading Parameters ===
SYMBOL=EURUSD
MAGIC_NUMBER=12345
TIMEFRAME=5

; === Scoring System ===
SCORE_MIN_ENTRY=7
SCORE_HIGH_CONFIDENCE=11

; === Risk Management ===
RISK_MODE=0
RISK_PERCENT_NORMAL=0.8
RISK_PERCENT_HIGH=1.2
SL_POINTS=150
TP_MULTIPLIER=3
MAX_POSITIONS=1
USE_DYNAMIC_LOTS=true
LOG_LOT_CALCULATION=true

; === Indicator Parameters ===
ADX_PERIOD=8
RSI_PERIOD=10
MA_PERIOD=34
MA_METHOD=0

; === ADX Thresholds ===
ADX_THRESHOLD_WEAK=15
ADX_THRESHOLD_MODERATE=18
ADX_THRESHOLD_STRONG=25
ADX_THRESHOLD_VERY_STRONG=32

; === Volatility Filter ===
USE_VOLATILITY_FILTER=true
ATR_PERIOD=14
MIN_VOLATILITY_RATIO=0.0003
MAX_VOLATILITY_RATIO=0.0015

; === Trailing Stop ===
USE_TRAILING=false
TRAILING_START=50
TRAILING_STEP=20

; === Advanced Trailing TP ===
USE_ADVANCED_TRAILING_TP=false
ADVANCED_TRAILING_START=100
ADVANCED_TRAILING_STEP=50
ADVANCED_TRAILING_MIN_DISTANCE=30
