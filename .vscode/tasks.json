{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile MQL5",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$file='${file}';$ext=[System.IO.Path]::GetExtension($file);if($ext-eq'.mq5'){& 'C:\\Program Files\\FTMO Global Markets MT5 Terminal\\MetaEditor64.exe' '/compile:${file}' '/log:${workspaceFolder}\\build\\mql5-compile.log'}else{Write-Host 'Error: Only .mq5 files can be compiled. Current file:' $file -ForegroundColor Red;exit 1}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "owner": "mql5",
          "fileLocation": ["absolute"],
          "pattern": {
            "regexp": "^(.*\\.mq5)\\((\\d+),(\\d+)\\)\\s*:\\s*(error|warning)\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        }
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    }
  ]
}
